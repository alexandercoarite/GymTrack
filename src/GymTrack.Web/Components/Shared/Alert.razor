@if (!string.IsNullOrWhiteSpace(Message))
{
    <div role="alert" class="mb-4 ui-alert @Variant">@Message</div>
}

@code {
    [Parameter] public string Kind { get; set; } = "info";
    [Parameter] public string? Message { get; set; }

    private string Variant => Kind switch
    {
        "success" => "ui-alert-ok",
        "error" => "ui-alert-error",
        "warning" => "ui-alert-warn",
        _ => "ui-alert-info"
    };
}
