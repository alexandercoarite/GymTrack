<Modal Visible="Visible" Title="@Title" OnClose="OnCancel">
    <p class="text-sm text-gray-300">@Message</p>
    <div class="mt-6 flex justify-end gap-2">
        <button type="button" class="btn-ghost" @onclick="OnCancel">Cancelar</button>
        <button type="button" class="btn-danger" @onclick="OnConfirm">@ConfirmText</button>
    </div>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmar acción";
    [Parameter] public string Message { get; set; } = "¿Seguro que deseas continuar?";
    [Parameter] public string ConfirmText { get; set; } = "Eliminar";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
