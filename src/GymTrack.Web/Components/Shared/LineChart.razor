@if (Points.Count == 0)
{
    <p class="text-sm text-gym-muted">Aún no hay datos para mostrar.</p>
}
else
{
    <svg viewBox="0 0 600 220" class="h-auto w-full" role="img" aria-label="@AriaLabel">
        <line x1="@PadL" y1="@PadT" x2="@PadL" y2="@(Height - PadB)" stroke="#2a313a" />
        <line x1="@PadL" y1="@(Height - PadB)" x2="@(Width - PadR)" y2="@(Height - PadB)" stroke="#2a313a" />
        <text x="@(PadL - 6)" y="@(PadT + 4)" text-anchor="end" font-size="11" fill="#8b95a1">@Fmt(max)</text>
        <text x="@(PadL - 6)" y="@(Height - PadB)" text-anchor="end" font-size="11" fill="#8b95a1">@Fmt(min)</text>
        <polyline fill="none" stroke="#39ff14" stroke-width="2.5" stroke-linejoin="round" points="@Polyline" />
        @for (var i = 0; i < Points.Count; i++)
        {
            var x = X(i);
            var y = Y(Points[i].Value);
            <circle cx="@Fmt(x)" cy="@Fmt(y)" r="4" fill="#39ff14"><title>@Points[i].Label: @Fmt(Points[i].Value) @Unit</title></circle>
        }
        <text x="@PadL" y="@(Height - 8)" font-size="11" fill="#8b95a1">@Points[0].Label</text>
        <text x="@(Width - PadR)" y="@(Height - 8)" text-anchor="end" font-size="11" fill="#8b95a1">@Points[^1].Label</text>
    </svg>
}

@code {
    [Parameter] public IReadOnlyList<(string Label, double Value)> Points { get; set; } = Array.Empty<(string, double)>();
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public string AriaLabel { get; set; } = "Gráfico de evolución";

    private const int Width = 600, Height = 220, PadL = 48, PadR = 16, PadT = 16, PadB = 32;
    private double min, max;

    protected override void OnParametersSet()
    {
        if (Points.Count == 0) return;
        min = Points.Min(p => p.Value);
        max = Points.Max(p => p.Value);
        if (Math.Abs(max - min) < 0.001) { min -= 1; max += 1; }
        var pad = (max - min) * 0.1;
        min -= pad;
        max += pad;
    }

    private double X(int i) => Points.Count == 1
        ? PadL + (Width - PadL - PadR) / 2.0
        : PadL + i * (Width - PadL - PadR) / (double)(Points.Count - 1);

    private double Y(double v) => Height - PadB - (v - min) / (max - min) * (Height - PadT - PadB);

    private string Polyline => string.Join(" ", Points.Select((p, i) => $"{Fmt(X(i))},{Fmt(Y(p.Value))}"));

    private static string Fmt(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
