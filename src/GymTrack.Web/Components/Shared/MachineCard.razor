<button type="button" class="card fade-in w-full text-left transition hover:border-gym-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-gym-accent @(Machine.Estado != MachineStatus.Disponible ? "opacity-80" : "")"
        @onclick="() => OnSelect.InvokeAsync(Machine)">
    <div class="mb-4 flex h-36 items-center justify-center overflow-hidden rounded-xl bg-gym-dark">
        @if (!string.IsNullOrWhiteSpace(Machine.ImagenRuta))
        {
            <img src="@Machine.ImagenRuta" alt="@Machine.Nombre" class="h-full w-full object-cover" loading="lazy" />
        }
        else
        {
            <span class="text-5xl" aria-hidden="true">🏋️</span>
        }
    </div>
    <div class="flex items-start justify-between gap-2">
        <h3 class="font-bold leading-tight">@Machine.Nombre</h3>
        <StatusBadge Status="Machine.Estado" />
    </div>
    <p class="mt-1 text-xs text-gym-muted">@Machine.GrupoMuscular · @Machine.Tipo.Label()</p>
    <p class="mt-2 line-clamp-2 text-sm text-gray-300">@Machine.Descripcion</p>
</button>

@code {
    [Parameter, EditorRequired] public MachineDto Machine { get; set; } = default!;
    [Parameter] public EventCallback<MachineDto> OnSelect { get; set; }
}
