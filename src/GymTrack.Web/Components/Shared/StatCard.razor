<div class="card fade-in">
    <p class="text-xs font-semibold uppercase tracking-wide text-gym-muted">@Label</p>
    <p class="mt-2 text-3xl font-extrabold @(Accent ? "text-gym-accent" : "text-white")">@Value</p>
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <p class="mt-1 text-xs text-gym-muted">@Hint</p>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Accent { get; set; }
}
