@page "/cuenta/recuperar"
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService Email
@inject NavigationManager Nav

<PageTitle>Recuperar contraseña · GymTrack</PageTitle>

<AuthCard Title="Recuperar contraseña" Subtitle="Escribe tu correo y te enviaremos un enlace para crear una contraseña nueva.">
<ChildContent>
    @if (sent)
    {
        <Alert Kind="success" Message="Si el correo está registrado, recibirás un enlace para restablecer tu contraseña." />
        <a href="/cuenta/iniciar-sesion" class="ui-btn ui-btn-soft">Volver a iniciar sesión</a>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="Send" FormName="forgot-password" class="space-y-4">
            <DataAnnotationsValidator />
            <div>
                <label for="email" class="ui-label">Correo electrónico</label>
                <InputText id="email" type="email" @bind-Value="Input.Email" class="ui-input" autocomplete="email" />
                <ValidationMessage For="() => Input.Email" />
            </div>
            <button type="submit" class="ui-btn ui-btn-primary w-full">Enviar enlace</button>
        </EditForm>
    }
</ChildContent>
</AuthCard>

@code {
    private bool sent;

    [SupplyParameterFromForm] private ForgotModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task Send()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        if (user is not null && user.Activo)
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var link = Nav.GetUriWithQueryParameters(
                Nav.ToAbsoluteUri("cuenta/restablecer").AbsoluteUri,
                new Dictionary<string, object?> { ["email"] = user.Email, ["code"] = code });
            await Email.SendAsync(user.Email!, "Restablece tu contraseña de GymTrack",
                $"Para crear una contraseña nueva abre este enlace: {link}");
        }
        // Siempre se muestra el mismo mensaje para no revelar qué correos existen.
        sent = true;
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "El correo electrónico es obligatorio.")]
        [EmailAddress(ErrorMessage = "El correo electrónico no es válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
