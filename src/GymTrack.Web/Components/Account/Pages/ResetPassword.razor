@page "/cuenta/restablecer"
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Nueva contraseña · GymTrack</PageTitle>

<AuthCard Title="Crear contraseña nueva">
<ChildContent>
    @if (done)
    {
        <Alert Kind="success" Message="Tu contraseña fue actualizada correctamente." />
        <a href="/cuenta/iniciar-sesion" class="ui-btn ui-btn-primary">Iniciar sesión</a>
    }
    else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
    {
        <Alert Kind="error" Message="El enlace no es válido. Solicita uno nuevo." />
        <a href="/cuenta/recuperar" class="ui-btn ui-btn-soft">Solicitar enlace</a>
    }
    else
    {
        <Alert Kind="error" Message="@error" />
        <EditForm Model="Input" method="post" OnValidSubmit="Reset" FormName="reset-password" class="mt-4 space-y-4">
            <DataAnnotationsValidator />
            <div>
                <label for="password" class="ui-label">Contraseña nueva</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" class="ui-input" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Password" />
            </div>
            <div>
                <label for="confirmar" class="ui-label">Confirmar contraseña</label>
                <InputText id="confirmar" type="password" @bind-Value="Input.Confirmar" class="ui-input" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Confirmar" />
            </div>
            <button type="submit" class="ui-btn ui-btn-primary w-full">Guardar contraseña</button>
        </EditForm>
    }
</ChildContent>
</AuthCard>

@code {
    private bool done;
    private string? error;

    [SupplyParameterFromForm] private ResetModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();
    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Code { get; set; }
    private async Task Reset()
    {
        var user = await UserManager.FindByEmailAsync(Email!);
        if (user is null)
        {
            error = "El enlace no es válido o ya expiró.";
            return;
        }

        string token;
        try { token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code!)); }
        catch (FormatException)
        {
            error = "El enlace no es válido o ya expiró.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded) done = true;
        else error = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma tu contraseña.")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string Confirmar { get; set; } = string.Empty;
    }
}
