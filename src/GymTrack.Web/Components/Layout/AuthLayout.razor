@inherits LayoutComponentBase
@inject IOptions<GymInfo> Info

<div class="min-h-screen bg-linear-to-br from-stone-50 via-amber-50/60 to-stone-100 px-4 py-12">
    <main class="mx-auto w-full max-w-xl">
        <a href="/" class="mb-8 flex items-center justify-center gap-2.5 text-lg font-semibold tracking-tight text-stone-900 hover:opacity-70">
            <span class="grid size-9 place-items-center rounded-xl bg-stone-900 text-sm font-bold text-white" aria-hidden="true">G</span>
            @Info.Value.Name
        </a>
        @Body
        <p class="mt-8 text-center text-sm"><a href="/" class="ui-link">Volver al inicio</a></p>
    </main>
</div>
