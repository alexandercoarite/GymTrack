@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-3xl font-extrabold">Algo salió mal</h1>
    <p class="mt-3 text-stone-600">Ocurrió un error al procesar tu solicitud. Inténtalo de nuevo en unos minutos.</p>
    @if (ShowRequestId)
    {
        <p class="mt-4 text-xs text-stone-600">Código de solicitud: <code>@RequestId</code></p>
    }
    <a href="/" class="ui-btn ui-btn-primary mt-6">Volver al inicio</a>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
