@page "/admin/mantenimiento"
@inject IMaintenanceService MaintenanceSvc
@inject IMachineService MachineSvc

<PageTitle>Mantenimiento · GymTrack</PageTitle>

<PageHeader Title="Mantenimiento de equipos" Subtitle="Registra problemas y devuelve las máquinas a servicio." />
<Alert Kind="error" Message="@Error" />
<Alert Kind="success" Message="@Ok" />

<section class="card mb-6">
    <h2 class="font-bold">Registrar máquina en mantenimiento</h2>
    <EditForm Model="form" OnValidSubmit="Register" class="mt-4 grid gap-4 md:grid-cols-3">
        <DataAnnotationsValidator />
        <div>
            <label for="maquina" class="label-gym">Máquina</label>
            <InputSelect id="maquina" @bind-Value="form.MachineId" class="input-gym">
                <option value="0">Selecciona…</option>
                @foreach (var m in machines.Where(m => m.Estado != MachineStatus.EnMantenimiento))
                {
                    <option value="@m.Id">@m.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => form.MachineId" />
        </div>
        <div class="md:col-span-2">
            <label for="problema" class="label-gym">Descripción del problema</label>
            <InputText id="problema" @bind-Value="form.Descripcion" class="input-gym" />
            <ValidationMessage For="() => form.Descripcion" />
        </div>
        <div class="md:col-span-3">
            <button type="submit" class="btn-primary" disabled="@Busy">Registrar mantenimiento</button>
        </div>
    </EditForm>
</section>

<section class="card">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-bold">Registros</h2>
        <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" @bind="showClosed" @bind:after="Load" /> Mostrar también los cerrados
        </label>
    </div>
    @if (records.Count == 0)
    {
        <p class="mt-3 text-sm text-gym-muted">No hay registros de mantenimiento.</p>
    }
    else
    {
        <div class="mt-3 overflow-x-auto">
            <table class="table-gym">
                <thead><tr><th>Máquina</th><th>Problema</th><th>Inicio</th><th>Fin</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in records)
                    {
                        <tr>
                            <td class="font-semibold">@r.Maquina</td>
                            <td class="max-w-xs">
                                @r.Descripcion
                                @if (!string.IsNullOrWhiteSpace(r.Observaciones)) { <p class="text-xs text-gym-muted">Obs.: @r.Observaciones</p> }
                            </td>
                            <td>@r.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@(r.FechaFin?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                            <td><span class="badge @(r.Estado == MaintenanceStatus.Abierto ? "badge-warn" : "badge-ok")">@r.Estado.Label()</span></td>
                            <td class="text-right">
                                @if (r.Estado == MaintenanceStatus.Abierto)
                                {
                                    <button type="button" class="btn-primary btn-sm" @onclick="() => OpenResolve(r)">Marcar como resuelto</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<Modal Visible="resolving != null" Title="Cerrar mantenimiento" OnClose="() => resolving = null">
    <p class="text-sm text-gray-300">La máquina «@resolving?.Maquina» volverá a estar disponible.</p>
    <div class="mt-4">
        <label for="obs" class="label-gym">Observaciones (opcional)</label>
        <textarea id="obs" rows="3" maxlength="1000" class="input-gym" @bind="notes"></textarea>
    </div>
    <div class="mt-5 flex justify-end gap-2">
        <button type="button" class="btn-ghost" @onclick="() => resolving = null">Cancelar</button>
        <button type="button" class="btn-primary" @onclick="Resolve" disabled="@Busy">Confirmar</button>
    </div>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "maquina")] private int? PreselectedMachine { get; set; }

    private MaintenanceCreateModel form = new();
    private IReadOnlyList<MachineDto> machines = Array.Empty<MachineDto>();
    private IReadOnlyList<MaintenanceDto> records = Array.Empty<MaintenanceDto>();
    private bool showClosed;
    private MaintenanceDto? resolving;
    private string? notes;

    protected override async Task OnInitializedAsync()
    {
        if (PreselectedMachine.HasValue) form.MachineId = PreselectedMachine.Value;
        await Load();
    }

    private async Task Load() =>
        await Safe(async () =>
        {
            machines = await MachineSvc.SearchAsync();
            records = await MaintenanceSvc.ListAsync(soloAbiertos: !showClosed);
        }, keepMessages: true);

    private async Task Register()
    {
        var saved = await Safe(async () => await MaintenanceSvc.RegisterAsync(form), "Mantenimiento registrado. La máquina quedó en mantenimiento.");
        if (saved)
        {
            form = new MaintenanceCreateModel();
            await Load();
        }
    }

    private void OpenResolve(MaintenanceDto r)
    {
        resolving = r;
        notes = null;
    }

    private async Task Resolve()
    {
        var target = resolving;
        if (target == null) return;
        var done = await Safe(async () => await MaintenanceSvc.ResolveAsync(target.Id, notes), "Mantenimiento cerrado. La máquina está disponible.");
        if (done) resolving = null;
        await Load();
    }
}
