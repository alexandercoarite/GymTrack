@page "/admin/horarios"
@inject IOpeningHourService Hours

<PageTitle>Horarios · GymTrack</PageTitle>

<PageHeader Title="Horarios de atención" Subtitle="Se muestran automáticamente en la página principal y en el panel del cliente." />
<Alert Kind="error" Message="@Error" />
<Alert Kind="success" Message="@Ok" />

<section class="card">
    <h2 class="font-bold">Horario semanal</h2>
    @if (week == null)
    {
        <p class="mt-3 text-gym-muted">Cargando…</p>
    }
    else
    {
        <div class="mt-4 space-y-3">
            @foreach (var h in week)
            {
                <div class="grid items-center gap-3 rounded-xl border border-gym-border p-3 md:grid-cols-4">
                    <p class="font-semibold">@DayLabels.Of(h.Dia)</p>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="h.Abierto" /> Abierto
                    </label>
                    <div>
                        <label class="sr-only" for="ap-@h.Dia">Apertura @DayLabels.Of(h.Dia)</label>
                        <input id="ap-@h.Dia" type="time" class="input-gym" @bind="h.Apertura" @bind:format="HH:mm" disabled="@(!h.Abierto)" />
                    </div>
                    <div>
                        <label class="sr-only" for="ci-@h.Dia">Cierre @DayLabels.Of(h.Dia)</label>
                        <input id="ci-@h.Dia" type="time" class="input-gym" @bind="h.Cierre" @bind:format="HH:mm" disabled="@(!h.Abierto)" />
                    </div>
                </div>
            }
        </div>
        <p class="hint-gym">Desmarca «Abierto» para marcar un día de descanso.</p>
        <button type="button" class="btn-primary mt-4" @onclick="SaveWeek" disabled="@Busy">Guardar horario semanal</button>
    }
</section>

<section class="card mt-6">
    <div class="flex items-center justify-between">
        <h2 class="font-bold">Horarios especiales y cierres temporales</h2>
        <button type="button" class="btn-primary btn-sm" @onclick="NewSpecial">+ Nuevo</button>
    </div>
    @if (special.Count == 0)
    {
        <p class="mt-3 text-sm text-gym-muted">No hay horarios especiales registrados.</p>
    }
    else
    {
        <table class="table-gym mt-3">
            <thead><tr><th>Fecha</th><th>Descripción</th><th>Horario</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in special)
                {
                    <tr>
                        <td>@s.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@s.Descripcion</td>
                        <td>
                            @if (s.Abierto && s.Apertura != null && s.Cierre != null)
                            {
                                @($"{s.Apertura:HH\\:mm} – {s.Cierre:HH\\:mm}")
                            }
                            else { <span class="text-gym-danger">Cerrado</span> }
                        </td>
                        <td class="text-right">
                            <button type="button" class="btn-ghost btn-sm" @onclick="() => EditSpecial(s)">Editar</button>
                            <button type="button" class="btn-danger btn-sm" @onclick="() => toDelete = s">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<Modal Visible="showForm" Title="@(form.Id == 0 ? "Nuevo horario especial" : "Editar horario especial")" OnClose="() => showForm = false">
    <EditForm Model="form" OnValidSubmit="SaveSpecial" class="space-y-4">
        <DataAnnotationsValidator />
        <Alert Kind="error" Message="@Error" />
        <div>
            <label for="fecha" class="label-gym">Fecha</label>
            <input id="fecha" type="date" class="input-gym" @bind="form.Fecha" />
        </div>
        <div>
            <label for="desc" class="label-gym">Descripción</label>
            <InputText id="desc" @bind-Value="form.Descripcion" class="input-gym" placeholder="Ej.: Feriado, mantenimiento general…" />
            <ValidationMessage For="() => form.Descripcion" />
        </div>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" @bind="form.Abierto" /> El gimnasio abre ese día</label>
        @if (form.Abierto)
        {
            <div class="grid gap-3 md:grid-cols-2">
                <div><label for="sa" class="label-gym">Apertura</label><input id="sa" type="time" class="input-gym" @bind="form.Apertura" @bind:format="HH:mm" /></div>
                <div><label for="sc" class="label-gym">Cierre</label><input id="sc" type="time" class="input-gym" @bind="form.Cierre" @bind:format="HH:mm" /></div>
            </div>
        }
        <div class="flex justify-end gap-2">
            <button type="button" class="btn-ghost" @onclick="() => showForm = false">Cancelar</button>
            <button type="submit" class="btn-primary" disabled="@Busy">Guardar</button>
        </div>
    </EditForm>
</Modal>

<ConfirmDialog Visible="toDelete != null" Title="Eliminar horario especial"
               Message="¿Eliminar este horario especial?" OnConfirm="DeleteSpecial" OnCancel="() => toDelete = null" />

@code {
    private List<OpeningHourModel>? week;
    private List<SpecialOpeningHourModel> special = new();
    private SpecialOpeningHourModel form = new();
    private SpecialOpeningHourModel? toDelete;
    private bool showForm;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() =>
        await Safe(async () =>
        {
            week = (await Hours.GetWeekAsync()).ToList();
            special = (await Hours.GetSpecialAsync(soloProximos: false)).ToList();
        }, keepMessages: true);

    private async Task SaveWeek() =>
        await Safe(async () => await Hours.SaveWeekAsync(week!), "Horario semanal guardado.");

    private void NewSpecial()
    {
        form = new SpecialOpeningHourModel { Fecha = DateOnly.FromDateTime(DateTime.Today.AddDays(1)) };
        Error = null; Ok = null;
        showForm = true;
    }

    private void EditSpecial(SpecialOpeningHourModel s)
    {
        form = new SpecialOpeningHourModel
        {
            Id = s.Id, Fecha = s.Fecha, Abierto = s.Abierto, Apertura = s.Apertura, Cierre = s.Cierre, Descripcion = s.Descripcion
        };
        Error = null; Ok = null;
        showForm = true;
    }

    private async Task SaveSpecial()
    {
        var saved = await Safe(async () => await Hours.SaveSpecialAsync(form), "Horario especial guardado.");
        if (saved)
        {
            showForm = false;
            await Load();
        }
    }

    private async Task DeleteSpecial()
    {
        var target = toDelete;
        toDelete = null;
        if (target == null) return;
        await Safe(async () => await Hours.DeleteSpecialAsync(target.Id), "Horario especial eliminado.");
        await Load();
    }
}
